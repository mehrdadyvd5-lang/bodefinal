<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== App font ===================== -->
    <!-- Embedded IRANSansX (FaNum variant: Persian digits render correctly).
         Falls back to Segoe UI / Tahoma for any glyph it doesn't cover. -->
    <FontFamily x:Key="AppFont">
        pack://application:,,,/Assets/Fonts/#IRANSansXFaNum, Segoe UI, Tahoma
    </FontFamily>

    <!-- ===================== Palette ===================== -->
    <!-- Keeps the original product's green identity, modernised -->
    <Color x:Key="BrandGreenDark">#0E7A3B</Color>
    <Color x:Key="BrandGreen">#2FAE60</Color>
    <Color x:Key="BrandGreenLight">#7BD68A</Color>
    <Color x:Key="GlassWhite">#CCFFFFFF</Color>
    <Color x:Key="BgTop">#0E7A3B</Color>
    <Color x:Key="BgBottom">#0B4A2A</Color>

    <SolidColorBrush x:Key="BrandGreenDarkBrush" Color="{StaticResource BrandGreenDark}" />
    <SolidColorBrush x:Key="BrandGreenBrush" Color="{StaticResource BrandGreen}" />
    <SolidColorBrush x:Key="BrandGreenLightBrush" Color="{StaticResource BrandGreenLight}" />
    <SolidColorBrush x:Key="GlassWhiteBrush" Color="{StaticResource GlassWhite}" />

    <!-- Applies AppFont to every Window/TextBlock/Control by default, so
         individual screens never need to set FontFamily themselves. -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    </Style>
    <Style TargetType="Control">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    </Style>

    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BgTop}" Offset="0" />
        <GradientStop Color="{StaticResource BgBottom}" Offset="1" />
    </LinearGradientBrush>

    <!-- ===================== Glass Panel ===================== -->
    <!-- Frosted-glass card used for every dialog/panel in the app -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassWhiteBrush}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.35" Color="Black" Direction="270" />
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.35" />
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                         From="0.96" To="1" Duration="0:0:0.35">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                         From="0.96" To="1" Duration="0:0:0.35">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Pill Button (Registration / Visitor / Admin) ===================== -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrandGreenDarkBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            CornerRadius="24">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35" Color="Black" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bg"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#0A5A2C" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bg"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource BrandGreenDark}" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Glass Text Field ===================== -->
    <Style x:Key="GlassTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#F2FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandGreenLightBrush}" />
        <Setter Property="BorderThickness" Value="1.2" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="#F2FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandGreenLightBrush}" />
        <Setter Property="BorderThickness" Value="1.2" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Page/window fade+slide transition used when navigating between screens -->
    <Storyboard x:Key="PageEnterStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
        <ThicknessAnimation Storyboard.TargetProperty="Margin"
                             From="0,24,0,-24" To="0,0,0,0" Duration="0:0:0.3">
            <ThicknessAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
            </ThicknessAnimation.EasingFunction>
        </ThicknessAnimation>
    </Storyboard>

</ResourceDictionary>
