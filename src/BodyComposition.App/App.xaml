<Application x:Class="BodyComposition.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Our custom glass / animation theme -->
                <ResourceDictionary Source="Themes/GlassTheme.xaml" />

                <!-- Active language dictionary. Swapped at runtime by LocalizationService -->
                <ResourceDictionary Source="Resources/Strings/Strings.fa.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
