<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net48 = works officially on Windows 7 SP1, 10, and 11 -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>HumanBodyCompositionMonitor</AssemblyName>
    <RootNamespace>BodyComposition.App</RootNamespace>
    <!-- Add Assets\app.ico and uncomment once you have the real app icon -->
    <!-- <ApplicationIcon>Assets\app.ico</ApplicationIcon> -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>5.0.0</Version>
    <Product>Human Body Composition Monitoring System</Product>
    <Company></Company>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Persian UI font, embedded so it works even if not installed on the PC -->
    <Resource Include="Assets\Fonts\IRANSansXFaNum-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lightweight local storage for offline data -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
