<Window x:Class="BodyComposition.App.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_CreateNewUser}"
        Height="640" Width="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border Background="{StaticResource AppBackgroundBrush}" CornerRadius="20">
        <Border.Effect><DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.5" Color="Black" /></Border.Effect>
        <Grid Margin="18">
            <Border Style="{StaticResource GlassCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_CreateNewUser}" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource BrandGreenDarkBrush}" Margin="0,0,0,14" />

                        <TextBlock Text="* Account No." FontSize="12" Foreground="#333" Margin="0,0,0,4" />
                        <TextBlock x:Name="AccountNoText" Text="(assigned automatically)" FontSize="12" Foreground="#666" Margin="0,0,0,12" />

                        <TextBlock Foreground="#333" FontSize="12" Margin="0,0,0,4">
                            <Run Text="* " /><Run Text="{DynamicResource Str_Name}" />
                        </TextBlock>
                        <TextBox x:Name="NameBox" Style="{StaticResource GlassTextBox}" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Foreground="#333" FontSize="12" Margin="0,0,0,4">
                                    <Run Text="* " /><Run Text="{DynamicResource Str_Sex}" />
                                </TextBlock>
                                <ComboBox x:Name="SexCombo" Padding="8,7" SelectedIndex="0">
                                    <ComboBoxItem Content="{DynamicResource Str_Male}" />
                                    <ComboBoxItem Content="{DynamicResource Str_Female}" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Str_ActivityLevel}" FontSize="12" Foreground="#333" Margin="0,0,0,4" />
                                <ComboBox x:Name="ActivityCombo" Padding="8,7" SelectedIndex="1">
                                    <ComboBoxItem Content="{DynamicResource Str_ActivityLow}" />
                                    <ComboBoxItem Content="{DynamicResource Str_ActivityMedium}" />
                                    <ComboBoxItem Content="{DynamicResource Str_ActivityHigh}" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Foreground="#333" FontSize="12" Margin="0,0,0,4">
                            <Run Text="* " /><Run Text="{DynamicResource Str_Race}" />
                        </TextBlock>
                        <ComboBox x:Name="RaceCombo" Padding="8,7" SelectedIndex="0" Margin="0,0,0,12">
                            <ComboBoxItem Content="Asian" /><ComboBoxItem Content="Caucasian" />
                            <ComboBoxItem Content="African" /><ComboBoxItem Content="Other" />
                        </ComboBox>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Foreground="#333" FontSize="12" Margin="0,0,0,4">
                                    <Run Text="* " /><Run Text="{DynamicResource Str_Password}" />
                                </TextBlock>
                                <PasswordBox x:Name="PasswordBox" Style="{StaticResource GlassPasswordBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="#333" FontSize="12" Margin="0,0,0,4">
                                    <Run Text="* " /><Run Text="{DynamicResource Str_ConfirmPassword}" />
                                </TextBlock>
                                <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource GlassPasswordBox}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Foreground="#333" FontSize="12" Margin="0,0,0,4">
                                    <Run Text="* " /><Run Text="{DynamicResource Str_Birthday}" />
                                </TextBlock>
                                <DatePicker x:Name="BirthdayPicker" Padding="6" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="#333" FontSize="12" Margin="0,0,0,4">
                                    <Run Text="* " /><Run Text="{DynamicResource Str_Height}" /><Run Text=" (cm)" />
                                </TextBlock>
                                <TextBox x:Name="HeightBox" Style="{StaticResource GlassTextBox}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{DynamicResource Str_TelMobile}" FontSize="12" Foreground="#333" Margin="0,0,0,4" />
                        <TextBox x:Name="TelBox" Style="{StaticResource GlassTextBox}" Margin="0,0,0,12" />

                        <TextBlock Text="{DynamicResource Str_Address}" FontSize="12" Foreground="#333" Margin="0,0,0,4" />
                        <TextBox x:Name="AddressBox" Style="{StaticResource GlassTextBox}" Margin="0,0,0,6" />

                        <TextBlock x:Name="ErrorText" Foreground="#B00020" FontSize="12" Margin="0,10,0,0"
                                   Visibility="Collapsed" TextWrapping="Wrap" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{DynamicResource Str_Create}" Style="{StaticResource PillButton}" Click="Create_Click" />
                            <Button Grid.Column="2" Content="{DynamicResource Str_Cancel}" Style="{StaticResource PillButton}"
                                    Background="#6B6B6B" Click="Cancel_Click" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
