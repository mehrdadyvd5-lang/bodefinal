<Window x:Class="BodyComposition.App.Views.QuestionnaireWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Questionnaire}" Height="680" Width="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Background="{StaticResource AppBackgroundBrush}" CornerRadius="20">
        <Border.Effect><DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.5" Color="Black" /></Border.Effect>
        <Grid Margin="16">
            <Border Style="{StaticResource GlassCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource Str_Questionnaire}" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource BrandGreenDarkBrush}" Margin="0,0,0,10" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="QuestionsPanel" />
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{DynamicResource Str_Save}" Style="{StaticResource PillButton}" Click="Save_Click" />
                        <Button Grid.Column="2" Content="{DynamicResource Str_Cancel}" Style="{StaticResource PillButton}"
                                Background="#6B6B6B" Click="Cancel_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
