<Window x:Class="BodyComposition.App.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_AppTitle}"
        Height="800" Width="1180"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Background="{StaticResource AppBackgroundBrush}" CornerRadius="18">
        <Border.Effect><DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.5" Color="Black" /></Border.Effect>
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleUserText" Foreground="White" FontWeight="Bold" FontSize="13"
                           VerticalAlignment="Center" Margin="14,0,0,0" />
                <TextBlock Text="{DynamicResource Str_AdapterNotFound}" Foreground="#FFDDDD" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Content="{DynamicResource Str_LanguageToggle}" Margin="0,0,8,0" Padding="10,4"
                            Background="Transparent" BorderThickness="1" BorderBrush="White" Foreground="White" FontSize="11"
                            Click="LanguageToggle_Click" />
                    <Button Content="🔵" ToolTip="Bluetooth" Width="30" Height="30" Background="Transparent"
                            BorderThickness="0" Foreground="White" Click="Bluetooth_Click" />
                    <Button Content="{DynamicResource Str_Logout}" Padding="10,4" Margin="6,0,0,0"
                            Background="Transparent" BorderThickness="1" BorderBrush="White" Foreground="White" FontSize="11"
                            Click="Logout_Click" />
                    <Button Content="✕" Width="34" Height="34" Background="Transparent" BorderThickness="0"
                            Foreground="White" FontSize="14" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F2FFFFFF" CornerRadius="14" Padding="10">
                    <StackPanel x:Name="SidebarPanel" />
                </Border>

                <ContentControl Grid.Column="2" x:Name="ContentHost" />
            </Grid>
        </Grid>
    </Border>
</Window>
