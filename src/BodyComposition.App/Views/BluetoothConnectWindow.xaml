<Window x:Class="BodyComposition.App.Views.BluetoothConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bluetooth" Height="360" Width="500"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Background="{StaticResource AppBackgroundBrush}" CornerRadius="18">
        <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="Black" /></Border.Effect>
        <Grid Margin="14">
            <Border Style="{StaticResource GlassCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="No." FontWeight="Bold" Foreground="#222" />
                        <TextBlock Grid.Column="1" Text="{DynamicResource Str_Analyzer}" FontWeight="Bold" Foreground="#222" />
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl x:Name="DevicesList" />
                    </ScrollViewer>

                    <TextBlock x:Name="MissingText" Grid.Row="2" Text="{DynamicResource Str_BluetoothMissing}"
                               Foreground="#B00020" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,10" />

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{DynamicResource Str_Connect}" Style="{StaticResource PillButton}" Margin="0,0,4,0" Click="Connect_Click" />
                        <Button Grid.Column="1" Content="{DynamicResource Str_Refresh}" Style="{StaticResource PillButton}" Background="#2F5FA8" Margin="4,0,4,0" Click="Refresh_Click" />
                        <Button Grid.Column="2" Content="{DynamicResource Str_Stop}" Style="{StaticResource PillButton}" Background="#6B6B6B" Margin="4,0,4,0" Click="Stop_Click" />
                        <Button Grid.Column="3" Content="{DynamicResource Str_Close}" Style="{StaticResource PillButton}" Background="#A83636" Margin="4,0,0,0" Click="Close_Click" />
                    </Grid>
                    <CheckBox x:Name="AutoConnectCheck" Content="{DynamicResource Str_AutoConnectLast}"
                              Grid.Row="3" VerticalAlignment="Bottom" Margin="0,50,0,0" IsChecked="True" Foreground="#333" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
