<Window x:Class="BodyComposition.App.Views.VisitorModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_VisitorMode}" Height="720" Width="900"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Background="{StaticResource AppBackgroundBrush}" CornerRadius="20">
        <Border.Effect><DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.5" Color="Black" /></Border.Effect>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="4,4,4,10">
                <TextBlock Text="{DynamicResource Str_VisitorMode}" Foreground="White" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                <Button Content="✕" HorizontalAlignment="Right" Width="34" Height="34"
                        Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" Click="Close_Click" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource GlassCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Str_Name}" FontSize="12" Foreground="#333" Margin="0,0,0,4" />
                        <TextBox x:Name="NameBox" Style="{StaticResource GlassTextBox}" Margin="0,0,0,12" />

                        <TextBlock Text="{DynamicResource Str_Sex}" FontSize="12" Foreground="#333" Margin="0,0,0,4" />
                        <ComboBox x:Name="SexCombo" Padding="8,7" SelectedIndex="0" Margin="0,0,0,12">
                            <ComboBoxItem Content="{DynamicResource Str_Male}" />
                            <ComboBoxItem Content="{DynamicResource Str_Female}" />
                        </ComboBox>

                        <TextBlock Text="{DynamicResource Str_Race}" FontSize="12" Foreground="#333" Margin="0,0,0,4" />
                        <ComboBox x:Name="RaceCombo" Padding="8,7" SelectedIndex="0" Margin="0,0,0,12">
                            <ComboBoxItem Content="Asian" /><ComboBoxItem Content="Caucasian" />
                            <ComboBoxItem Content="African" /><ComboBoxItem Content="Other" />
                        </ComboBox>

                        <TextBlock Text="Age" FontSize="12" Foreground="#333" Margin="0,0,0,4" />
                        <TextBox x:Name="AgeBox" Style="{StaticResource GlassTextBox}" Margin="0,0,0,12" />

                        <TextBlock Text="{DynamicResource Str_Height}" FontSize="12" Foreground="#333" Margin="0,0,0,4" />
                        <TextBox x:Name="HeightBox" Style="{StaticResource GlassTextBox}" Margin="0,0,0,12" />

                        <TextBlock Text="{DynamicResource Str_Weight}" FontSize="12" Foreground="#333" Margin="0,0,0,4" />
                        <TextBox x:Name="WeightBox" Style="{StaticResource GlassTextBox}" Margin="0,0,0,16" />

                        <Button x:Name="StartButton" Content="{DynamicResource Str_Start}" Style="{StaticResource PillButton}" Click="Start_Click" />
                        <TextBlock x:Name="ErrorText" Foreground="#B00020" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <StackPanel x:Name="MetricsPanel" />

                        <TextBlock Text="{DynamicResource Str_BodyTypeEvaluation}" FontSize="12" FontWeight="Bold" Foreground="#333" Margin="0,14,0,4" />
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="10" MinHeight="60">
                            <TextBlock x:Name="BodyTypeText" TextWrapping="Wrap" FontSize="12" Foreground="#222" />
                        </Border>

                        <TextBlock Text="{DynamicResource Str_HealthWarning}" FontSize="12" FontWeight="Bold" Foreground="#B00020" Margin="0,12,0,4" />
                        <Border Background="#FFF3F3" CornerRadius="8" Padding="10" MinHeight="50">
                            <TextBlock x:Name="HealthWarningText" TextWrapping="Wrap" FontSize="12" Foreground="#7A1D1D" />
                        </Border>

                        <Button x:Name="PrintButton" Content="{DynamicResource Str_Print}" Style="{StaticResource PillButton}"
                                Background="#6B6B6B" HorizontalAlignment="Right" Margin="0,14,0,0" IsEnabled="False" Click="Print_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
