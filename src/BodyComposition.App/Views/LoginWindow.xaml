<Window x:Class="BodyComposition.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_AppTitle}"
        Height="560" Width="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource AppBackgroundBrush}" CornerRadius="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{DynamicResource Str_AppTitle}" Foreground="White"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="20,0,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Content="{DynamicResource Str_LanguageToggle}"
                            Margin="0,0,8,0" Padding="10,4"
                            Background="Transparent" BorderThickness="1" BorderBrush="White"
                            Foreground="White" FontSize="11" Cursor="Hand"
                            Click="LanguageToggle_Click" />
                    <Button Content="✕" Width="34" Height="34"
                            Background="Transparent" BorderThickness="0" Foreground="White"
                            FontSize="14" Cursor="Hand" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Main glass card: login fields left, illustration right -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="30,0,30,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: fields -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="10,0,20,0">

                        <TextBlock Text="{DynamicResource Str_UserId}" FontSize="14"
                                   Foreground="{StaticResource BrandGreenDarkBrush}" FontWeight="Bold"
                                   Margin="2,0,0,4" />
                        <ComboBox x:Name="UserIdCombo" IsEditable="True" Padding="10,8"
                                  Margin="0,0,0,16" />

                        <TextBlock Text="{DynamicResource Str_Password}" FontSize="14"
                                   Foreground="{StaticResource BrandGreenDarkBrush}" FontWeight="Bold"
                                   Margin="2,0,0,4" />
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource GlassPasswordBox}"
                                     Margin="0,0,0,10" />

                        <TextBlock x:Name="ErrorText" Foreground="#B00020" FontSize="12"
                                   Visibility="Collapsed" Margin="2,4,0,4" TextWrapping="Wrap" />

                        <Button Content="{DynamicResource Str_Go}" Style="{StaticResource PillButton}"
                                Width="130" HorizontalAlignment="Left" Margin="0,14,0,0"
                                Click="Go_Click" />

                        <UniformGrid Rows="1" Columns="3" Margin="0,34,0,0">
                            <Button Content="{DynamicResource Str_Registration}"
                                    Style="{StaticResource PillButton}" Margin="0,0,6,0"
                                    Click="Registration_Click" />
                            <Button Content="{DynamicResource Str_VisitorMode}"
                                    Style="{StaticResource PillButton}" Margin="6,0,6,0"
                                    Click="VisitorMode_Click" />
                            <Button Content="{DynamicResource Str_AdminMode}"
                                    Style="{StaticResource PillButton}" Margin="6,0,0,0"
                                    Click="AdminMode_Click" />
                        </UniformGrid>

                        <StackPanel Orientation="Horizontal" Margin="2,30,0,0" VerticalAlignment="Bottom">
                            <TextBlock Text="&#128246;" FontSize="16" Foreground="{StaticResource BrandGreenBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Bluetooth 4.0" FontSize="11" Foreground="#666"
                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                            <TextBlock Text="{DynamicResource Str_Version}" FontSize="11" Foreground="#999"
                                       VerticalAlignment="Center" Margin="16,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: illustration placeholder (swap for the runner artwork asset) -->
                    <Border Grid.Column="1" CornerRadius="16" Margin="10,10,0,10"
                            Background="#14FFFFFF">
                        <TextBlock Text="&#127939;" FontSize="70" Opacity="0.6"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Footer bar (matches the green footer strip in the original) -->
            <Border Grid.Row="2" Background="{StaticResource BrandGreenDarkBrush}"
                    CornerRadius="0,0,24,24">
                <Grid Margin="20,0">
                    <TextBlock Text="{DynamicResource Str_AppTitle}" Foreground="White"
                               VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
