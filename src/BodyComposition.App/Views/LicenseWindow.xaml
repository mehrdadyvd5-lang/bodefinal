<Window x:Class="BodyComposition.App.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_AppTitle}"
        Height="480" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource AppBackgroundBrush}" CornerRadius="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar (custom, draggable, since WindowStyle=None) -->
            <Grid Grid.Row="0" Height="40" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="34" Height="34" Margin="0,4,8,0"
                        Background="Transparent" BorderThickness="0" Foreground="White"
                        FontSize="14" Cursor="Hand" Click="CloseButton_Click" />
                <Button Content="{DynamicResource Str_LanguageToggle}"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="10,6,0,0" Padding="10,4"
                        Background="Transparent" BorderThickness="1" BorderBrush="White"
                        Foreground="White" FontSize="11" Cursor="Hand"
                        Click="LanguageToggle_Click" />
            </Grid>

            <!-- Glass card -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="28,0,28,28">
                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="&#128274;" FontSize="42"
                               HorizontalAlignment="Center" Margin="0,0,0,10" />

                    <TextBlock Text="{DynamicResource Str_LicenseTitle}"
                               FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{StaticResource BrandGreenDarkBrush}" />

                    <TextBlock Text="{DynamicResource Str_LicenseSubtitle}"
                               FontSize="12" Foreground="#666" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Margin="10,6,10,18" />

                    <TextBlock Text="{DynamicResource Str_LicenseCodeLabel}"
                               FontSize="12" Foreground="#444" Margin="2,0,0,4" />
                    <TextBox x:Name="LicenseCodeBox" Style="{StaticResource GlassTextBox}"
                             Text="{Binding LicenseCode, UpdateSourceTrigger=PropertyChanged}"
                             CharacterCasing="Upper" />

                    <TextBlock x:Name="StatusText" Margin="0,12,0,0" FontSize="12"
                               TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="#B00020" Visibility="Collapsed" />

                    <ProgressBar x:Name="Spinner" IsIndeterminate="True" Height="3"
                                 Margin="0,14,0,0" Visibility="Collapsed"
                                 Foreground="{StaticResource BrandGreenBrush}" />

                    <Button Content="{DynamicResource Str_LicenseActivate}"
                            Style="{StaticResource PillButton}"
                            HorizontalAlignment="Center" Margin="0,22,0,0"
                            Width="180" Click="Activate_Click" />

                    <TextBlock Text="{DynamicResource Str_Version}" FontSize="10"
                               Foreground="#999" HorizontalAlignment="Center" Margin="0,18,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
