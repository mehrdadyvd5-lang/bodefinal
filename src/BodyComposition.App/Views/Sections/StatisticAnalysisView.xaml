<UserControl x:Class="BodyComposition.App.Views.Sections.StatisticAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource GlassCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="220" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="BMI" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrandGreenDarkBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{DynamicResource Str_AnalysisCycle}" VerticalAlignment="Center" FontSize="12" Foreground="#333" Margin="0,0,8,0" />
                    <ComboBox x:Name="CycleCombo" Width="90" SelectedIndex="0">
                        <ComboBoxItem Content="{DynamicResource Str_CycleDay}" />
                        <ComboBoxItem Content="{DynamicResource Str_CycleWeek}" />
                        <ComboBoxItem Content="{DynamicResource Str_CycleMonth}" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#FDF9EE" CornerRadius="10" Padding="10">
                <Canvas x:Name="ChartCanvas" />
            </Border>

            <TextBlock x:Name="NoDataText" Grid.Row="2" Text="{DynamicResource Str_NoData}"
                       Foreground="#666" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed" />

            <ScrollViewer Grid.Row="3" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="HistoryList" />
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
