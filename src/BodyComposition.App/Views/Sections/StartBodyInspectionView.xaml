<UserControl x:Class="BodyComposition.App.Views.Sections.StartBodyInspectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource GlassCard}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_BodyInspectionDate}" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource BrandGreenDarkBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="DateText" Grid.Column="1" FontSize="13" Foreground="#333"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>

                <StackPanel x:Name="MetricsPanel" />

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Str_UpperBalance}" FontSize="11" Foreground="#333" />
                        <TextBlock x:Name="UpperBalanceText" FontSize="14" FontWeight="Bold" Foreground="#111" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource Str_TotalBalance}" FontSize="11" Foreground="#333" />
                        <TextBlock x:Name="TotalBalanceText" FontSize="14" FontWeight="Bold" Foreground="#111" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Str_LowerBalance}" FontSize="11" Foreground="#333" />
                        <TextBlock x:Name="LowerBalanceText" FontSize="14" FontWeight="Bold" Foreground="#111" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Str_TotalScore}" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource BrandGreenDarkBrush}" />
                        <TextBlock x:Name="TotalScoreText" FontSize="20" FontWeight="Bold" Foreground="#0E7A3B" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource Str_BioAge}" FontSize="12" FontWeight="Bold" Foreground="#333" />
                        <TextBlock x:Name="BioAgeText" FontSize="20" FontWeight="Bold" Foreground="#111" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{DynamicResource Str_BodyTypeEvaluation}" FontSize="12" FontWeight="Bold"
                           Foreground="#333" Margin="0,16,0,4" />
                <Border Background="#FFFFFF" CornerRadius="8" Padding="10" MinHeight="60">
                    <TextBlock x:Name="BodyTypeText" TextWrapping="Wrap" FontSize="12" Foreground="#222" />
                </Border>

                <TextBlock Text="{DynamicResource Str_HealthAdvice}" FontSize="12" FontWeight="Bold"
                           Foreground="#333" Margin="0,12,0,4" />
                <Border Background="#FFFFFF" CornerRadius="8" Padding="10" MinHeight="50">
                    <TextBlock x:Name="HealthAdviceTextBlock" TextWrapping="Wrap" FontSize="12" Foreground="#222" />
                </Border>

                <TextBlock Text="{DynamicResource Str_HealthWarning}" FontSize="12" FontWeight="Bold"
                           Foreground="#B00020" Margin="0,12,0,4" />
                <Border Background="#FFF3F3" CornerRadius="8" Padding="10" MinHeight="50">
                    <TextBlock x:Name="HealthWarningTextBlock" TextWrapping="Wrap" FontSize="12" Foreground="#7A1D1D" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                <Button x:Name="StartButton" Content="{DynamicResource Str_Start}" Style="{StaticResource PillButton}"
                        Margin="0,0,0,10" Click="Start_Click" />
                <Button x:Name="SaveButton" Content="{DynamicResource Str_Save}" Style="{StaticResource PillButton}"
                        Background="#2F5FA8" Margin="0,0,0,10" Click="Save_Click" IsEnabled="False" />
                <Button x:Name="PrintButton" Content="{DynamicResource Str_Print}" Style="{StaticResource PillButton}"
                        Background="#6B6B6B" Click="Print_Click" IsEnabled="False" />
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="#0E7A3B" Margin="0,12,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
