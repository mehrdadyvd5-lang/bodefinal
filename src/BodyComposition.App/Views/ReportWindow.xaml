<Window x:Class="BodyComposition.App.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report" Height="720" Width="820"
        WindowStartupLocation="CenterScreen">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrandGreenDarkBrush}" Padding="16,10">
            <Grid>
                <TextBlock Text="{DynamicResource Str_AppTitle}" Foreground="White" FontWeight="Bold" FontSize="14"
                           VerticalAlignment="Center" />
                <Button Content="{DynamicResource Str_Print}" HorizontalAlignment="Right" Padding="14,6"
                        Background="White" Foreground="{StaticResource BrandGreenDarkBrush}" FontWeight="Bold"
                        BorderThickness="0" Click="PrintButton_Click" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="ReportRoot" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Name" FontWeight="Bold" Foreground="#222" />
                        <TextBlock x:Name="NameText" Foreground="#333" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Gender" FontWeight="Bold" Foreground="#222" />
                        <TextBlock x:Name="GenderText" Foreground="#333" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Age" FontWeight="Bold" Foreground="#222" />
                        <TextBlock x:Name="AgeText" Foreground="#333" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Height / Time" FontWeight="Bold" Foreground="#222" />
                        <TextBlock x:Name="HeightTimeText" Foreground="#333" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" x:Name="IndicatorsPanel" />
                    <StackPanel Grid.Column="2">
                        <Border Background="#F0FBF3" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_TotalScore}" FontSize="12" Foreground="#333" />
                                <TextBlock x:Name="TotalScoreText" FontSize="24" FontWeight="Bold" Foreground="#0E7A3B" />
                            </StackPanel>
                        </Border>
                        <Border Background="#F5F5F5" CornerRadius="10" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_BioAge}" FontSize="12" Foreground="#333" />
                                <TextBlock x:Name="BioAgeText" FontSize="24" FontWeight="Bold" Foreground="#222" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <TextBlock Text="{DynamicResource Str_BodyTypeEvaluation}" FontWeight="Bold" Foreground="#0E7A3B" Margin="0,0,0,6" />
                    <Border Background="#F5FAF6" CornerRadius="8" Padding="12">
                        <TextBlock x:Name="BodyTypeText" TextWrapping="Wrap" Foreground="#222" />
                    </Border>
                    <TextBlock Text="{DynamicResource Str_HealthAdvice}" FontWeight="Bold" Foreground="#0E7A3B" Margin="0,12,0,6" />
                    <Border Background="#F5FAF6" CornerRadius="8" Padding="12">
                        <TextBlock x:Name="HealthAdviceText" TextWrapping="Wrap" Foreground="#222" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="{DynamicResource Str_HealthWarning}" FontWeight="Bold" Foreground="#B00020" Margin="0,0,0,6" />
                    <Border Background="#FFF3F3" CornerRadius="8" Padding="12">
                        <TextBlock x:Name="HealthWarningText" TextWrapping="Wrap" Foreground="#7A1D1D" />
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
